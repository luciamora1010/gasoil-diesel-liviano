  input[type=range].rng:focus-visible { outline: 3px solid var(--moss); outline-offset: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .rise, .dot, .pill-sel, .halo, .floaty, .flow, .bub, .draw { animation: none !important; }
    .draw { stroke-dashoffset: 0; }
    * { transition: none !important; scroll-behavior: auto !important; }
  }
</style>

