  .sec:hover rect.body { filter: brightness(1.07); }
  .sec:focus-visible { outline: none; }
  .sec:focus-visible rect.pill { stroke: var(--ink); stroke-width: 3; }
  .lift { transition: transform .2s ease, box-shadow .2s ease; }
  .lift:hover { transform: translateY(-2px); }

  input[type=range].rng {
    -webkit-appearance: none; appearance: none; width: 100%; height: 12px; border-radius: 999px;
    background: linear-gradient(to right, var(--moss) var(--p), var(--sand) var(--p)); outline: none; cursor: pointer; position: relative;
  }
  input[type=range].rng::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; box-sizing: border-box; width: 30px; height: 30px; border-radius: 50%;
