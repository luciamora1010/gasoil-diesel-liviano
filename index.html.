  .dot { animation: dotin .35s cubic-bezier(.2,.9,.3,1.3) both; }
  .pill-sel { transform-box: fill-box; transform-origin: center; animation: pillpop .35s ease-out both; }
  .halo { animation: breathe 2.6s ease-in-out infinite; }
  .floaty { animation: floaty 7s ease-in-out infinite; }
  .flow { stroke-dasharray: 6 6; animation: flow 1.1s linear infinite; }
  .bub { animation: bub 2.4s ease-in infinite; }
  .draw { stroke-dasharray: 1; animation: draw .9s ease-out both; }
  .sec { cursor: pointer; }
